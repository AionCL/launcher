<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
    <Package Name="AionCL Launcher" Manufacturer="AionCL" Version="2.5.19"
           UpgradeCode="7E8E6F4D-6F1A-4D9A-9A6C-2A2B9D8D2C41"
           Scope="perMachine">
    <SummaryInformation Description="AionCL Classic 2.4 launcher" />
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente du launcher est déjà installée." />
    <MediaTemplate EmbedCab="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Mondo" InstallDirectory="INSTALLFOLDER" />
    <Feature Id="MainFeature" Title="AionCL Launcher" Description="Fichiers nécessaires au fonctionnement du launcher." Level="1" Display="expand">
      <ComponentGroupRef Id="LauncherComponents" />
      <Feature Id="StartMenuFeature" Title="Raccourci Menu Démarrer" Description="Ajouter AionCL Launcher au Menu Démarrer." Level="1">
        <ComponentGroupRef Id="StartMenuComponents" />
      </Feature>
      <Feature Id="DesktopFeature" Title="Raccourci Bureau" Description="Ajouter AionCL Launcher sur le Bureau." Level="1">
        <ComponentGroupRef Id="DesktopComponents" />
      </Feature>
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="AionCL Launcher" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AIONCLMENU" Name="AionCL Launcher" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="LauncherComponents" Directory="INSTALLFOLDER">
      <Component Id="LauncherFiles" Guid="*">
        <File Id="LauncherExe" Source="$(var.SourceDir)\AionCL.Launcher.exe" KeyPath="yes" />
        <File Id="LauncherConfig" Source="$(var.SourceDir)\AionCL.Launcher.exe.config" />
        <File Id="LauncherJson" Source="$(var.SourceDir)\launcher.json" />
      </Component>
      <Component Id="UpdaterComponent" Guid="D0E1E2F3-4A5B-46C7-8D9E-0F1A2B3C4D5E">
        <File Id="UpdaterExe" Source="$(var.SourceDir)\AionCL.Updater.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="StartMenuComponents" Directory="AIONCLMENU">
      <Component Id="StartMenuShortcutComponent" Guid="*">
        <Shortcut Id="StartMenuShortcut" Target="[#LauncherExe]" Name="AionCL Launcher"
                  Description="Lancer AionCL Classic 2.4" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AionCL\Launcher" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopComponents" Directory="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut Id="DesktopShortcut" Target="[#LauncherExe]" Name="AionCL Launcher"
                  Description="Lancer AionCL Classic 2.4" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\AionCL\Launcher" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
